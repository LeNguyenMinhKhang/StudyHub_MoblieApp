<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/signInFragment">

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.doan.studyhub.user.ui.auth.SignIn"
        android:label="Đăng nhập"
        tools:layout="@layout/sign_in">
        <action
            android:id="@+id/action_signIn_to_signUp"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_signIn_to_forgotPassword"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_signIn_to_main"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.doan.studyhub.user.ui.auth.SignUp"
        android:label="Đăng ký"
        tools:layout="@layout/sign_up">
        <action
            android:id="@+id/action_signUp_to_main"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/signUpFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.doan.studyhub.user.ui.auth.ForgotPassword"
        android:label="Quên mật khẩu"
        tools:layout="@layout/forgot_password" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.doan.studyhub.user.ui.home.Home"
        android:label="Trang chủ"
        tools:layout="@layout/home">
        <action
            android:id="@+id/action_main_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
