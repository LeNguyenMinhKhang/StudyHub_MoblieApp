<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/group_back"
            app:tint="#1E293B" />
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:maxLines="1"
            android:ellipsize="end"
            android:accessibilityHeading="true"
            android:layout_marginStart="8dp" />
        <TextView
            android:id="@+id/tvSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/newerBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:visibility="gone">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/doc_newer" />
        <Button
            android:id="@+id/btnNewer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc_open_newer" />
    </LinearLayout>

    <!-- Compact call controls + optional follow-the-guide -->
    <LinearLayout
        android:id="@+id/callBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EEF2FF"
        android:paddingHorizontal="8dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvCallState"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:accessibilityLiveRegion="polite" />
            <Button
                android:id="@+id/btnCallMic"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp" />
            <Button
                android:id="@+id/btnCallCamera"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp" />
            <Button
                android:id="@+id/btnCallReturn"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/call_return" />
            <Button
                android:id="@+id/btnCallLeave"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/call_leave" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/guideRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnGuide"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp" />
            <CheckBox
                android:id="@+id/chkFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/doc_guide_follow" />
            <TextView
                android:id="@+id/tvGuide"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:accessibilityLiveRegion="polite" />
            <Button
                android:id="@+id/btnGuideOpen"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/doc_guide_open"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:accessibilityLiveRegion="polite" />
    <Button
        android:id="@+id/btnRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/group_retry"
        android:visibility="gone" />

    <!-- PDF Presentation Container with Top Page Pill & Bottom Icon Toolbar Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.doan.studyhub.user.ui.group.document.PdfPageView
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E5E7EB"
            android:contentDescription="@string/doc_viewer_desc" />

        <!-- Floating Top Page Indicator Pill -->
        <LinearLayout
            android:id="@+id/topPagePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_page_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:elevation="6dp">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/doc_prev"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_forward"
                android:contentDescription="@string/doc_next"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Floating Bottom Compact Icon Toolbar -->
        <LinearLayout
            android:id="@+id/bottomToolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pdf_toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:elevation="8dp">

            <ImageButton
                android:id="@+id/toolView"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_visibility"
                android:contentDescription="@string/doc_tool_view"
                app:tint="#0F172A" />

            <ImageButton
                android:id="@+id/toolInk"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                android:contentDescription="@string/doc_tool_ink"
                app:tint="#64748B" />

            <ImageButton
                android:id="@+id/toolHighlight"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_highlight"
                android:contentDescription="@string/doc_tool_highlight"
                app:tint="#64748B" />

            <ImageButton
                android:id="@+id/toolNote"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_note"
                android:contentDescription="@string/doc_tool_note"
                app:tint="#64748B" />

            <ImageButton
                android:id="@+id/toolSelect"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_touch"
                android:contentDescription="@string/doc_tool_select"
                app:tint="#64748B" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_undo"
                android:contentDescription="@string/doc_undo"
                app:tint="#64748B" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert"
                android:contentDescription="@string/doc_more"
                app:tint="#0F172A" />
        </LinearLayout>

        <!-- Hidden legacy/overflow buttons retained for ViewBinding compatibility -->
        <View
            android:id="@+id/btnRotate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btnFit"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btnColor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btnConflicts"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/exportRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:visibility="gone">
        <ProgressBar
            android:id="@+id/exportProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btnCancelExport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/doc_export_cancel" />
    </LinearLayout>

</LinearLayout>