<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnBackBlockedUsers"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại cài đặt"
            android:padding="8dp"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_back" />

        <!-- Screen title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:accessibilityHeading="true"
            android:gravity="center_vertical"
            android:text="Người dùng đã chặn"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Initial loading -->
    <ProgressBar
        android:id="@+id/progressBlockedUsers"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Error message -->
    <TextView
        android:id="@+id/tvBlockedUsersError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/text_muted"
        android:visibility="gone" />

    <!-- Retry -->
    <Button
        android:id="@+id/btnRetryBlockedUsers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_retry"
        android:visibility="gone" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvBlockedUsersEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="Bạn chưa chặn người dùng nào."
        android:textColor="@color/text_muted"
        android:visibility="gone" />

    <!-- Blocked users list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBlockedUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <!-- Load more -->
    <ProgressBar
        android:id="@+id/progressBlockedMore"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

</LinearLayout>
