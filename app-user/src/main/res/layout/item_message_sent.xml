<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end|bottom"
    android:orientation="horizontal"
    android:paddingStart="64dp"
    android:paddingEnd="8dp"
    android:paddingVertical="1dp">

    <!-- Status sits beside the bubble; invisible (not gone) keeps the bubble from shifting -->
    <ImageView
        android:id="@+id/ivStatus"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        android:padding="5dp"
        android:src="@drawable/ic_message_sent_circle"
        tools:src="@drawable/ic_message_read_circle" />

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_bubble_sent"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:textColor="@color/on_primary"
            android:textSize="15sp"
            tools:text="Chào bạn, tài liệu môn này đã hoàn thành chưa nhỉ?" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMessageImage"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="2dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            tools:src="@drawable/logo1" />

        <LinearLayout
            android:id="@+id/layoutDocument"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_chat_doc_sent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivDocIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_file_document"
                app:tint="@color/on_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDocName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="@color/on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="De_cuong_on_tap.pdf" />

                <TextView
                    android:id="@+id/tvDocSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#D0FFFFFF"
                    android:textSize="11sp"
                    tools:text="1.5 MB • PDF" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivDocAction"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_download_file"
                app:tint="@color/on_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textColor="#D0FFFFFF"
            android:textSize="11sp"
            tools:text="14:32" />
    </LinearLayout>

</LinearLayout>
