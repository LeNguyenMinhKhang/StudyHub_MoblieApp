<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#111827">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
        <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/group_back" />
        <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/call_title" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" android:accessibilityHeading="true" />
        <Button android:id="@+id/btnDocuments" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/call_documents" />
    </LinearLayout>
    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:textColor="@android:color/white" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/tvNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:textColor="#FDE68A" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/btnRejoin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/call_rejoin" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="4dp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp">
            <Button android:id="@+id/btnMic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/call_mic_off" />
            <Button android:id="@+id/btnCamera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/call_cam_off" />
            <Button android:id="@+id/btnSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/call_switch_camera" />
            <Button android:id="@+id/btnRoute" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/call_audio_route_default" />
            <Button android:id="@+id/btnLeave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/call_leave" />
            <Button android:id="@+id/btnEnd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/call_end_all" android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
