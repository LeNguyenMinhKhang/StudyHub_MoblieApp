<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/admin_icon"
        android:roundIcon="@drawable/admin_icon"
        android:label="StudyHub Admin"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyHub">

        <!-- Login Screen (Launcher) -->
        <activity
            android:name=".ui.auth.AdminLoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register Screen -->
        <activity
            android:name=".ui.auth.AdminRegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Dashboard Screen (5 Tabs) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>
</manifest>
